# fake = in-process platform stand-in, no keys, no network (default). remote = a MultiAgency platform gateway.
PLATFORM=fake
PORT=3000
# remote only: the platform gateway and this app's deployment.
PLATFORM_URL=
PLATFORM_DEPLOYMENT=covenant
# remote only: the app credential (tap_...). Prefer a file; it stays in server memory, never in /api/config, events or logs.
PLATFORM_CREDENTIAL_FILE=
PLATFORM_CREDENTIAL=
# Optional extra CA (PEM) for the gateway's TLS certificate.
PLATFORM_CA_FILE=
# Dev/test only: a local platform stack's state directory. Fills URL, credential, CA and NEAR_RPC_URL and enables demo controls.
# Refused when NODE_ENV=production.
PLATFORM_STACK_DIR=
# One platform Organization per contract.
COVENANT_ORG_MODE=contract
# The [owner, read] consent runs this many days past the contract end, so held payouts can still be voted on.
CONSENT_GRACE_DAYS=30
# How often open payouts are followed with payouts/status.
STATUS_POLL_MS=60000
# NEAR RPC for full-access-key checks on signatures (stack: filled from PLATFORM_STACK_DIR).
NEAR_RPC_URL=
# fake = seeded pull requests, no network. github = public GitHub API.
GITHUB=fake
GITHUB_TOKEN=
# Optional. Path to a SQLite file; defaults to in-memory with the stand-in.
DB_PATH=
# Sign in with NEAR (Better-Auth + better-near-auth, as in everything.dev apps).
# Required when PLATFORM=remote: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Public origin of this app (used for auth cookies and redirects).
PUBLIC_URL=http://localhost:3000
# NEP-413 recipient shown in the wallet ("Sign in to multiagentic.near").
SIWN_RECIPIENT=multiagentic.near
# Require sign-in with the stand-in too (always required when PLATFORM=remote).
REQUIRE_AUTH=false
# The judge. With NEARAI_API_KEY set, a model on NEAR AI Cloud judges merged PRs against the scope.
NEARAI_API_KEY=
NEARAI_MODEL=z-ai/glm-5.3-flash
NEARAI_BASE_URL=https://cloud-api.near.ai/v1
# Force the rule-based judge even when a key is set: JUDGE=rules
JUDGE=
# Check active contracts for new merges every N ms (0 = only on "Check merges").
AGENT_POLL_MS=0
