# fake = in-process platform stand-in, no keys, no network (default). remote = a MultiAgency platform gateway.
PLATFORM=fake
PORT=3000
# remote only: the platform gateway and this app's deployment.
PLATFORM_URL=
# Paperwork deployment namespace; must match its credential and signed consents.
PLATFORM_DEPLOYMENT=multiagency-paperwork
# remote only: the app credential (tap_...). Prefer a file; it stays in server memory, never in /api/config, events or logs.
PLATFORM_CREDENTIAL_FILE=
PLATFORM_CREDENTIAL=
# Optional extra CA (PEM) for the gateway's TLS certificate.
PLATFORM_CA_FILE=
# Dev/test only: a local platform stack's state directory. Fills URL, credential, CA and NEAR_RPC_URL and enables demo controls.
# Refused when NODE_ENV=production.
PLATFORM_STACK_DIR=
# The [owner, read] consent runs this many days past the job end, so held payouts can still be voted on.
CONSENT_GRACE_DAYS=30
# How often open payouts are followed with payouts/status.
STATUS_POLL_MS=60000
# NEAR RPC for full-access-key checks on signatures (stack: filled from PLATFORM_STACK_DIR).
NEAR_RPC_URL=
# fake = seeded pull requests, no network. github = public GitHub API.
GITHUB=fake
GITHUB_TOKEN=
# Paperwork SQLite file. Omit for an in-memory stand-in; keep a durable file for remote mode.
# The new path does not migrate an old file. Old records need their original DB_PATH,
# PLATFORM_DEPLOYMENT and matching credential; a database/deployment mismatch is refused.
DB_PATH=./data/paperwork.sqlite
# Sign in with NEAR (Better-Auth + better-near-auth, as in everything.dev apps).
# Required when PLATFORM=remote: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Public origin of this app (used for auth cookies and redirects).
PUBLIC_URL=http://localhost:3000
# NEP-413 recipient shown in the wallet ("Sign in to multiagentic.near").
SIWN_RECIPIENT=multiagentic.near
# Require sign-in with the stand-in too (always required when PLATFORM=remote).
REQUIRE_AUTH=false
# The judge. With NEARAI_API_KEY set, a model on NEAR AI Cloud judges merged PRs against the scope.
NEARAI_API_KEY=
NEARAI_MODEL=z-ai/glm-5.3-flash
NEARAI_BASE_URL=https://cloud-api.near.ai/v1
# Deadline for report/invoice assessment, including the response body (milliseconds).
PAPERWORK_ASSESSMENT_TIMEOUT_MS=30000
# Force the rule-based judge even when a key is set: JUDGE=rules
JUDGE=
# Check active jobs for new merges every N ms (0 = only on "Check merges").
AGENT_POLL_MS=0
# Agent market (PLATFORM=remote; the local stack started with --market supplies its own market).
# The market's HTTP API, for its directory and the worker's jobs.
MARKET_URL=https://market.near.ai
# The worker: one agency's listed agent. All three or none. Token and secret are server secrets, never sent to a browser.
# The agent's aat_ token (from its owner's market account).
MARKET_AGENT_TOKEN=
# The webhook signing secret the market shows for the agent's webhook URL (<PUBLIC_URL>/api/market/webhook).
MARKET_WEBHOOK_SECRET=
# The Paperwork agency (its id, from #/market/<id>) whose market agent's deposit receives the earnings.
MARKET_WORKER_AGENCY=

# Optional overrides for isolated local demo scripts. Uncomment only the values needed.
# PAPERWORK_DEMO_ARTIFACTS=/tmp
# PAPERWORK_DEMO_PORT=3003
# PAPERWORK_BROWSER_FULL=1
# PAPERWORK_RESTART_ARTIFACTS=/tmp
# PAPERWORK_RESTART_DROP_WITHDRAW=1
# PAPERWORK_JOB_CHANGES=1
# PAPERWORK_JOB_LOST_REPLY=1
# PAPERWORK_BUDGET_USD=150
# PAPERWORK_INVOICE_USD=125
# PAPERWORK_EVIDENCE_URL=https://github.com/acme/app/pull/101
# PAPERWORK_REPORT=CSV export and acceptance tests are ready for review.
