# sim = local simulator, no keys, no network (default). live = NEAR Intents Agent API on mainnet (wired after the Nov 2-3 spikes).
PROVIDER=sim
PORT=3000
# Required when PROVIDER=live. 32 bytes hex; encrypts the grant token at rest.
SECRET_KEY=
# Required when PROVIDER=live. Your naa_ key from https://partners.near-intents.org/
NEAR_INTENTS_AGENT_API_KEY=
AGENT_API_BASE_URL=
# Money never moves unless this is true (live only).
ALLOW_WRITES=false
# fake = seeded pull requests, no network. github = public GitHub API.
GITHUB=fake
GITHUB_TOKEN=
# Optional. Path to a SQLite file; defaults to in-memory in sim mode.
DB_PATH=
# Sign in with NEAR (Better-Auth + better-near-auth, as in everything.dev apps).
# Required when PROVIDER=live: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Public origin of this app (used for auth cookies and redirects).
PUBLIC_URL=http://localhost:3000
# NEP-413 recipient shown in the wallet ("Sign in to multiagentic.near").
SIWN_RECIPIENT=multiagentic.near
# Require sign-in in the simulator too (always required when PROVIDER=live).
REQUIRE_AUTH=false
# The agent's judge. With NEARAI_API_KEY set, a model on NEAR AI Cloud judges merged PRs against the scope.
NEARAI_API_KEY=
NEARAI_MODEL=z-ai/glm-5.3-flash
NEARAI_BASE_URL=https://cloud-api.near.ai/v1
# Force the rule-based judge even when a key is set: JUDGE=rules
JUDGE=
# Check active contracts for new merges every N ms (0 = only on "Check merges").
AGENT_POLL_MS=0
